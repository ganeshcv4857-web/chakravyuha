// Windows resources: the game icon and version details shown in Explorer.
// GLFW (inside raylib) uses the icon named GLFW_ICON for the window and taskbar.
#include <winver.h>

GLFW_ICON ICON "chakravyuha.ico"

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Chakravyuha"
            VALUE "FileDescription",  "Chakravyuha - the spiral formation of Kurukshetra"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "chakravyuha"
            VALUE "OriginalFilename", "Chakravyuha.exe"
            VALUE "ProductName",      "Chakravyuha"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
